/*--------------------------------*- C++ -*----------------------------------*\
  flame-to-flow: 2-D laminar channel of burnt methane-air gas.
  Template: f2f/foam.py fills in the double-brace placeholders.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}

// Burnt stoichiometric methane-air at {{Tduct}} K and 1 atm, from Cantera (GRI-Mech 3.0):
// mu = {{mu}} Pa s, rho = {{rho}} kg/m^3, nu = mu / rho
transportModel  Newtonian;

nu              [0 2 -1 0 0 0 0] {{nu}};
