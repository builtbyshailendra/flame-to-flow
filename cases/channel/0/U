/*--------------------------------*- C++ -*----------------------------------*\
  flame-to-flow: 2-D laminar channel of burnt methane-air gas.
  Template: f2f/foam.py fills in the double-brace placeholders.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

// Mean velocity U = Re nu / h = {{U}} m/s for Re = {{Re}}
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ({{U}} 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ({{U}} 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}
